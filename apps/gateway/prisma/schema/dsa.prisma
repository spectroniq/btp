
// ── DSA ───────────────────────────────────────────────
model DSAProblem {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  difficulty  Difficulty
  topic       String
  description String
  examples    String[]
  constraints String[]
  starterCode String   @default("")
  testCases   Json     @default("[]")
  createdAt   DateTime @default(now())

  attempts DSAAttempt[]

  @@map("dsa_problems")
  @@index([difficulty])
  @@index([topic])
}

model DSAAttempt {
  id          String   @id @default(uuid())
  userId      String
  problemId   String
  reasoning   String
  code        String?
  feedback    String?
  embedding   String? // stored as vector, managed by ai-engine
  createdAt   DateTime @default(now())

  user    User       @relation(fields: [userId], references: [id])
  problem DSAProblem @relation(fields: [problemId], references: [id])

  @@map("dsa_attempts")
  @@index([userId])
  @@index([problemId])
}
