
// ── GAMIFICATION ─────────────────────────────────────
model Badge {
  id          String   @id @default(uuid())
  name        String   @unique
  description String
  icon        String
  xpReward    Int      @default(0)

  users UserBadge[]

  @@map("badges")
}

model UserBadge {
  id       String   @id @default(uuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  badge Badge @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])

  @@map("user_badges")
}
