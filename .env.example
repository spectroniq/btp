# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# OpenRouter — routes to any model (https://openrouter.ai/keys)
# Free tier available; defaults to meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_API_KEY=sk-or-...
# Optional: override the model (e.g. anthropic/claude-sonnet-4-5 for Claude)
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Voyage AI — for DSA reasoning embeddings (https://dash.voyageai.com)
VOYAGE_API_KEY=pa-...

# SerpAPI — for job scraping (https://serpapi.com/dashboard)
# Leave blank to skip scraping
SERPAPI_KEY=

# Resend — for email notifications (https://resend.com/api-keys)
# Leave blank to skip email sending (notifications service still runs)
RESEND_API_KEY=
EMAIL_FROM=BTP <noreply@yourdomain.com>
